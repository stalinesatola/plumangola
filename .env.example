# Telegram bot usado para enviar as notificacoes de encomenda da /dlamini-loja
# Cria o bot com o @BotFather no Telegram e copia o token gerado.
TELEGRAM_BOT_TOKEN=

# ID do chat (privado ou de grupo) do revendedor Dlamini que deve receber os pedidos.
# Ver README.md -> "Obter o TELEGRAM_CHAT_ID" para instrucoes de como o descobrir.
TELEGRAM_CHAT_ID=

# Bot e chat do Telegram da Paulira Beauty (/paulirabeauty) -- separados dos
# do Dlamini acima, para nao misturar notificacoes de negocios diferentes.
# Cria um bot novo com o @BotFather e usa o chat_id da Paulira.
TELEGRAM_BOT_TOKEN_PAULIRA=
TELEGRAM_CHAT_ID_PAULIRA=

# Segredo usado para assinar as sessoes (JWT) do painel de admin.
# Gera um valor aleatorio, ex: `openssl rand -base64 32`.
AUTH_SECRET=

# Ligacao a base de dados Postgres do painel de admin (produtos, contas admin).
# Auto-preenchido pela Vercel quando ligas um Postgres store ao projeto
# (Storage -> Create Database -> Postgres -> Connect to Project).
# Localmente, corre `vercel env pull .env.local` em vez de preencher a mao.
POSTGRES_URL=

# Chave da API da Anthropic, usada por /empregos para extrair o perfil do CV
# carregado e avaliar a compatibilidade com cada vaga encontrada.
ANTHROPIC_API_KEY=

# Opcional: chave gratuita da NVIDIA NIM (build.nvidia.com), usada por
# /empregos como fallback automatico só quando uma chamada à Anthropic
# falha (erro, rate limit, sem credito) -- nunca como primeira opção.
# Sem esta variavel, uma falha da Anthropic simplesmente devolve erro ao
# utilizador, como antes.
NVIDIA_API_KEY=
# Opcional: ID do modelo gratuito a usar no fallback (ver catalogo em
# https://build.nvidia.com). Default: nvidia/nemotron-3-super-120b-a12b
# (nota: chaves gratuitas costumam ficar limitadas ao modelo da pagina onde
# foram geradas -- ver README.md "Fallback gratuito (NVIDIA NIM)")
NVIDIA_MODEL=

# Bot e chat do Telegram dedicados a ALERTAS internos (lib/alerts.ts) --
# separados dos bots de negocio acima. Usados para notificar o dono do site
# sempre que um erro relevante acontece no servidor (ou e reportado por um
# error boundary no cliente), em vez de ficar so visivel nos logs da Vercel.
# Cria um bot novo com o @BotFather (ver README.md -> "Sistema de alertas").
TELEGRAM_BOT_TOKEN_ALERTS=
TELEGRAM_CHAT_ID_ALERTS=
